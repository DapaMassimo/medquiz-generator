# Normalise every text file to LF in the repository and in the working tree.
# Without eol=lf, core.autocrlf=true on Windows checks the Makefile out with
# CRLF and `make` fails under WSL.
* text=auto eol=lf

# Binaries: never touch line endings, never diff as text.
*.pdf   binary
*.xlsx  binary
*.png   binary
*.jpg   binary
*.ico   binary

# Generated lockfile: collapse it in diffs and reviews.
uv.lock linguist-generated=true
