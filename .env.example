# ---------------------------------------------------------------------------
# Provider keys (standard names, no prefix)
# ---------------------------------------------------------------------------
# OpenAI: used by the generator, the judges, the taxonomy builder (gpt-4o-mini by default)
# and by the dedup embeddings (text-embedding-3-small).
OPENAI_API_KEY=
# Anthropic: only needed when MQ_LLM_PROVIDER=anthropic (embeddings stay on OpenAI).
ANTHROPIC_API_KEY=
# LangSmith: only needed when MQ_LANGSMITH_TRACING=true.
LANGSMITH_API_KEY=
# Workspace region. Empty = LangSmith's default (US). EU workspaces need this set,
# otherwise traces go to the US endpoint and never appear, without raising an error.
LANGSMITH_ENDPOINT=

# ---------------------------------------------------------------------------
# Models — the single place where provider/model choices live
# ---------------------------------------------------------------------------
MQ_LLM_PROVIDER=openai                 # openai | anthropic
MQ_GENERATOR_MODEL=gpt-4o-mini         # question generation
MQ_JUDGE_MODEL=gpt-4o-mini             # independent verification judge
MQ_TAXONOMY_MODEL=gpt-4o-mini          # taxonomy extraction/normalisation
MQ_EVAL_JUDGE_MODEL=gpt-4o-mini        # eval harness style judge
MQ_EMBEDDING_MODEL=text-embedding-3-small
MQ_LLM_TEMPERATURE=0.1
MQ_LLM_MAX_RETRIES=3
# Comma-separated list shown in the UI model dropdown.
MQ_LLM_MODELS=gpt-4o-mini,gpt-4o,gpt-4.1-mini,gpt-4.1

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
MQ_RUNS_DIR=runs                       # one folder per run id with every artefact
MQ_GOLDEN_DIR=golden                   # golden/regression/*.json (promoted items)
# Empty uses the examples bundled in the package; set a path to supply your own
# (.txt free text or .json structured).
MQ_EXAMPLES_PATH=
MQ_PRICING_PATH=pricing.json           # USD per 1M tokens, editable without code changes

# ---------------------------------------------------------------------------
# Parsing (Docling)
# ---------------------------------------------------------------------------
# Parsed DoclingDocuments cached by PDF content hash (re-parsing is instant).
MQ_DOCLING_CACHE_DIR=.cache/docling
# Offline parsing: directory holding pre-downloaded Docling models (layout, tableformer, OCR).
# Download once with:
#   uv run python -c "from docling.utils.model_downloader import download_models; download_models()"
# They land in ~/.cache/docling/models. Leave empty to resolve models online on first parse.
MQ_DOCLING_ARTIFACTS_PATH=
# OCR is OFF by default: the inputs are native PDFs. Enable only for scanned documents.
MQ_DOCLING_DO_OCR=false
# OCR engine, allowlisted for licence reasons: rapidocr | easyocr | tesseract.
# Other Docling backends ship models under revenue-capped or undeclared licences.
MQ_DOCLING_OCR_ENGINE=rapidocr
MQ_USE_CACHE=true

# ---------------------------------------------------------------------------
# Pipeline knobs
# ---------------------------------------------------------------------------
MQ_PLAN_MIN_UNIT_CHARS=600             # smaller sibling sections are merged into one unit
MQ_MAX_EXAMPLES_IN_PROMPT=5            # upper bound of few-shot examples per call (3-5)
MQ_EXAMPLES_SELECTION=random           # random = k drawn from the whole pool, seeded by the
                                       # section so re-runs reproduce | first = first N of the
                                       # file, same for every unit | semantic = closest to the
                                       # section by embedding. Semantic is off until the pool
                                       # is large enough to hold real neighbours: below that
                                       # most slots fall back and it costs embeddings for
                                       # roughly the behaviour of 'first'.
MQ_EXAMPLES_MIN_SIMILARITY=0.3         # semantic only: below this cosine a match is not
                                       # convincing and the slot falls back to the head of the
                                       # file
MQ_VERIFY_JUDGE_ENABLED=true           # false = deterministic checks only
MQ_DEDUP_ENABLED=true
MQ_DEDUP_THRESHOLD=0.92                # cosine similarity above which a question is flagged
MQ_EXPORT_INCLUDE_FLAGGED=false        # flagged items are exported only on request

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
MQ_LANGSMITH_TRACING=false             # true = trace every LLM call in LangSmith
MQ_LANGSMITH_PROJECT=medquiz-generator
MQ_LOG_LEVEL=INFO
MQ_LOG_JSON=false                      # true = one JSON object per log line
